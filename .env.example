DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.vercel.app

# Supabase -> Connect button -> copy from the panel (do not type the host by hand)
# Local .env: Session pooler (port 5432). Vercel: Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres

# mock = no API key needed; anthropic | gemini | tavily_gemini = real analysis
#   tavily_gemini = Tavily web search (free plan) + Gemini without search tool
LLM_PROVIDER=mock

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash   # used when the main model answers 503 'high demand'

# Tavily (used when LLM_PROVIDER=tavily_gemini; also needs GEMINI_API_KEY)
TAVILY_API_KEY=

# Shared by all real providers
LLM_MAX_SEARCHES=5               # max web searches per analysis (cost control)
LLM_TIMEOUT_SECONDS=90
MOCK_DELAY_SECONDS=1.5          # fake latency when LLM_PROVIDER=mock

CACHE_TTL_HOURS=24
RATE_LIMIT_ANON_PER_DAY=5
RATE_LIMIT_USER_PER_DAY=20
IP_HASH_SALT=change-me
DEFAULT_COUNTRY=TR
